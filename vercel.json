{
  "version": 2,
  "functions": {
    "api/index.cjs": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy",       "value": "unsafe-none" },
        { "key": "Cross-Origin-Embedder-Policy",     "value": "unsafe-none" }
      ]
    }
  ]
}
