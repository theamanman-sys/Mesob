    "@mui/material": "^6.4.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.94",
    "axios": "^1.7.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.2",
    "react": "^18.3.1",
    "react-countup": "^6.5.0",
