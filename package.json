{
  "name": "mesobcenter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock-server": "node mock/server.cjs",
    "kill-mock": "node -e \"try{require('fs').readFileSync('mock/server.pid','utf8').trim().split('\\n').forEach(p=>{try{process.kill(parseInt(p))}catch(e){}})}catch(e){}\"",
    "dev:mock": "concurrently -n mock,vite -c yellow,cyan \"node mock/server.cjs\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview"
  },
